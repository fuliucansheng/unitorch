{
  "train_micro_batch_size_per_gpu": 1,
  "gradient_accumulation_steps": 1,
  "gradient_clipping": 1.0,
  "bf16": {
    "enabled": true
  },
  "zero_optimization": {
    "stage": 3,
    "offload_optimizer": {
      "device": "cpu",
      "pin_memory": false
    },
    "overlap_comm": false,
    "contiguous_gradients": true,
    "reduce_bucket_size": 20000000,
    "offload_param": {
      "device": "cpu",
      "pin_memory": false
    },
    "stage3_prefetch_bucket_size": 20000000,
    "stage3_param_persistence_threshold": 100000,
    "stage3_max_live_parameters": 100000000,
    "stage3_max_reuse_distance": 100000000
  },
  "optimizer": {
    "type": "AdamW",
    "params": {
      "lr": 1e-05,
      "betas": [
        0.9,
        0.999
      ],
      "eps": 1e-08,
      "weight_decay": 0.01
    }
  },
  "steps_per_print": 10,
  "wall_clock_breakdown": false
}
