{
  "name": "unitorch",
  "version": "1.0.0",
  "scripts": {
    "generate-skills": "python3 -m unitorch.cli.copilots.skills install all --folder ./skills --force true",
    "export-skills": "python3 -m unitorch.cli.copilots.skills export all --folder ./skills",
    "validate-skills": "python3 -m unitorch.cli.copilots.skills validate --folder ./skills"
  },
  "dependencies": {
    "pm2": "^6.0.8"
  }
}
